# Copy this file to .env and fill in your MongoDB Atlas connection string.
# Get MONGODB_URI from: Atlas UI -> Database -> Connect -> Drivers -> Python
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DB_NAME=business_search

# Comma-separated allow-list of frontend origins for CORS (M5.1).
# Defaults to the local Vite dev server; override in production with the
# deployed frontend URL(s).
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Query intent (M6.1 / M6.2) -------------------------------------------
# Which provider produces the "I understood you need..." panel.
#   auto      (default) llm -> fixture -> embedding classifier -> nothing
#   llm       LLM only, no fallback (so a model outage is visible, not silent)
#   embedding classifier only    fixture  demo fixtures only    off  disabled
# INTENT_PROVIDER=auto

# Leave LLM_API_KEY unset to run without an LLM: "auto" simply falls through to
# the fixture and classifier providers, and search is unaffected either way.
# NEVER commit a real key — .env is gitignored, this file is not.
# LLM_API_KEY=
# LLM_PROVIDER=anthropic          # anthropic | openai
# LLM_MODEL=claude-sonnet-5       # required when LLM_PROVIDER=openai
# LLM_BASE_URL=                   # override for a gateway / compatible server
# LLM_TIMEOUT_SECONDS=6
# LLM_MAX_TOKENS=400
#
# REASONING MODELS NEED MORE THAN THE 400 DEFAULT, and fail in a way that looks
# like a comprehension failure rather than a budget one. Measured with DeepSeek
# deepseek-v4-flash: one query spent all 400 tokens on reasoning_tokens and
# returned finish_reason="length" with content="" -- the reasoning trace had
# already reached the right answer, but nothing was left to emit it. Intent
# accuracy on the situational set went 9/10 -> 10/10 purely by raising this.
# Reasoning models also need a longer timeout than the interactive default.
#   LLM_MAX_TOKENS=1500
#   LLM_TIMEOUT_SECONDS=30
#
# Example: DeepSeek via the OpenAI-compatible path (no code change required).
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-v4-flash

# Cross-encoder reranking. RERANK_ENABLED is the kill switch and wins over the
# policy. "intent-gated" reranks only queries that name their service.
# RERANK_POLICY=intent-gated      # intent-gated | always | never
# RERANK_ENABLED=true

# Use the inferred intent's expanded_query for retrieval. Off by default: the
# expansion is built and returned, but its effect on ranking is unmeasured.
# INTENT_EXPANSION_ENABLED=false
