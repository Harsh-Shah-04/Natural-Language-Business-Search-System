# Base URL of the FastAPI backend. Copy this file to .env.local to override.
# Defaults to the local uvicorn address when unset (see src/api/client.ts).
# On Vercel, set this in Project Settings → Environment Variables to your
# Railway URL (no trailing slash), e.g. https://your-service.up.railway.app
# Vite inlines it at build time — change requires a redeploy.
VITE_API_BASE_URL=http://127.0.0.1:8000
